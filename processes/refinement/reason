#!/usr/bin/env bash
# Start a Claude session for interactive reasoning about the methodology
set -e
cd "$(git rev-parse --show-toplevel)"

# The prompt is too large for argv, so pass it as a system prompt file
prompt_file="$(mktemp)"
trap 'rm -f "$prompt_file"' EXIT
./processes/refinement/prompt-for-reasoning > "$prompt_file"
claude --append-system-prompt-file "$prompt_file" "Load the methodology."
