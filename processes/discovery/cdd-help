#!/usr/bin/env bash
# Print commands and their descriptions from project command directories.

dirs=("$@")
if [ "${#dirs[@]}" -eq 0 ]; then
    dirs=(./commands)
fi
grey='\033[37m'
reset='\033[0m'
seen=' help init print self-upgrade '

print_command() {
    local name="$1"
    local desc="${2:-}"

    if [ -n "$desc" ]; then
        desc="$(echo "$desc" | sed 's/./\L&/')"
        echo -e "$name ${grey}- $desc${reset}"
    else
        echo "$name"
    fi
}

print_command "cdd help" "Show available CDD commands"
print_command "cdd init [directory]" "Initialize a CDD project directory"
print_command "cdd print" "Print indexed project code"
print_command "cdd self-upgrade" "Self-upgrade CDD support from CDD_SOURCE_PATH"

for dir in "${dirs[@]}"; do
    [ -d "$dir" ] || continue

    for filepath in "$dir"/*; do
        [ -f "$filepath" ] || continue
        name=$(basename "$filepath")
        case "$seen" in
            *" $name "*) continue ;;
        esac
        seen="$seen$name "

        desc=$(tail -n +2 "$filepath" | awk 'NF && /^#/ { print; exit }' | sed 's/^#[[:space:]]*//')

        print_command "$name" "$desc"
    done
done
