#!/usr/bin/env bash

set -euo pipefail

project_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
plans_dir="$project_root/plans"
filter_kind="${1:-}"

if [ -n "$filter_kind" ]; then
  case "$filter_kind" in
    feature|problem)
      ;;
    *)
      printf 'usage: plans [feature|problem]\n' >&2
      exit 2
      ;;
  esac
fi

for kind in problems features; do
  if [ -n "$filter_kind" ] && [ "$kind" != "${filter_kind}s" ]; then
    continue
  fi

  kind_dir="$plans_dir/$kind"
  [ -d "$kind_dir" ] || continue

  for filepath in "$kind_dir"/*.md; do
    [ -f "$filepath" ] || continue
    if [ -n "$filter_kind" ]; then
      name="$(basename "$filepath" .md)"
    else
      name="$kind/$(basename "$filepath" .md)"
    fi
    echo "$name"
  done
done
