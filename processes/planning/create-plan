#!/usr/bin/env bash
# Create a plan file and open it in the editor.
set -euo pipefail

if [ "$#" -lt 2 ]; then
  printf 'usage: plans:features:create|plans:problems:create <description>\n' >&2
  exit 2
fi

kind="$1"
shift
title="$*"

case "$kind" in
  feature|problem)
    command_name="plans:${kind}s:create"
    ;;
  *)
    printf 'plans:%s:create: unsupported kind\n' "$kind" >&2
    exit 1
    ;;
esac

source_path="${BASH_SOURCE[0]}"
while [ -L "$source_path" ]; do
  source_dir="$(cd -P "$(dirname "$source_path")" >/dev/null 2>&1 && pwd)"
  source_path="$(readlink "$source_path")"
  case "$source_path" in
    /*) ;;
    *) source_path="$source_dir/$source_path" ;;
  esac
done

cdd_home="$(cd -P "$(dirname "$source_path")/../.." >/dev/null 2>&1 && pwd)"
project_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
plan_dir="$project_root/plans/${kind}s"
mkdir -p "$plan_dir"

normalized_title="${title//$'\u00A0'/ }"
if [[ "$normalized_title" =~ ^(.*[^[:space:]])\.md$ ]]; then
  normalized_title="${BASH_REMATCH[1]}"
fi
normalized_title="$(printf '%s' "$normalized_title" | sed -E 's/[^[:alpha:] _,:-]+//g; s/^[[:space:]]+//; s/[[:space:]]+$//')"

if [ -z "$normalized_title" ]; then
  printf '%s: invalid description: %s\n' "$command_name" "$title" >&2
  exit 1
fi

plan_file="$plan_dir/$normalized_title.md"
if [ ! -f "$plan_file" ]; then
  case "$kind" in
    problem)
      cat > "$plan_file" <<EOF
# $normalized_title

## Problem

Describe the problem you are trying to solve.

## Impact

Describe who is affected and how.

## Desired outcome

EOF
      ;;
    feature)
      cat > "$plan_file" <<EOF
# $normalized_title

## Feature

Describe the feature you want to build.

## Value

Describe why the feature matters.

## Notes

EOF
      ;;
  esac
fi

exec "$cdd_home/platform/cdd/cdd" ide:open "$plan_file"
