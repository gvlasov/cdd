#!/usr/bin/env bash
# Installs CDD methodology as Claude Code skill in ~/.claude/skills
set -e
cd "$(dirname "$0")"

# Create skills directory if it doesn't exist
mkdir -p ~/.claude/skills/concept_driven_design

# Generate and install the skill
./concepts/skills/build > ~/.claude/skills/concept_driven_design/SKILL.md

echo "Installed concept-driven-design skill to ~/.claude/skills/concept_driven_design/SKILL.md"
