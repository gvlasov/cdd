#!/usr/bin/env bash
# List all transactions by scanning for transactions directories, skipping gitignored files
set -euo pipefail

grey='\033[37m'
reset='\033[0m'

git_root="$(git rev-parse --show-toplevel)"
cd "$git_root"

while IFS= read -r -d '' path; do
  IFS='/' read -ra parts <<<"$path"
  for i in "${!parts[@]}"; do
    case "${parts[$i]}" in
      transactions|Transactions)
        [ $((i + 1)) -lt "${#parts[@]}" ] || continue
        concept_dir="$(IFS='/'; echo "${parts[*]:0:i}")"
        transaction_name="${parts[$((i + 1))]}"
        printf '%s\t%s\n' "$transaction_name" "$concept_dir"
        ;;
    esac
  done
done < <(git ls-files -z) |
  LC_ALL=C sort -u |
  while IFS=$'\t' read -r transaction_name concept_dir; do
    echo -e "$transaction_name ${grey}- $concept_dir${reset}"
  done
