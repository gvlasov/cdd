#!/usr/bin/env bash
# Initialize a CDD directory structure
set -euo pipefail

target="${1:-.}"

mkdir -p \
  "$target/concepts" \
  "$target/stakeholders" \
  "$target/processes" \
  "$target/platform" \
  "$target/commands" \
  "$target/sandbox"

printf 'Initialized CDD directory structure in %s\n' "$target"
