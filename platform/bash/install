#!/usr/bin/env bash
# Install CDD support for Bash for current user
set -euo pipefail

source_path="${BASH_SOURCE[0]}"
while [ -L "$source_path" ]; do
  source_dir="$(cd -P "$(dirname "$source_path")" >/dev/null 2>&1 && pwd)"
  source_path="$(readlink "$source_path")"
  case "$source_path" in
    /*) ;;
    *) source_path="$source_dir/$source_path" ;;
  esac
done

source_dir="$(cd -P "$(dirname "$source_path")" >/dev/null 2>&1 && pwd)"
cdd_home="$(cd "$source_dir/../.." >/dev/null 2>&1 && pwd)"
bin_dir="$HOME/.local/bin"
completion_dir="$HOME/.local/share/bash-completion/completions"

mkdir -p "$bin_dir" "$completion_dir"
ln -sfn "$cdd_home/platform/cdd/cdd" "$bin_dir/cdd"
command -p install -m 0644 "$cdd_home/platform/bash/completions/cdd" "$completion_dir/cdd"

printf 'Installed cdd to %s/cdd\n' "$bin_dir"
printf 'Installed Bash completion to %s/cdd\n' "$completion_dir"
