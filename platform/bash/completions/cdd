_cdd()
{
  local current previous commands command_dir cli_command

  COMPREPLY=()
  current="${COMP_WORDS[COMP_CWORD]}"
  previous="${COMP_WORDS[COMP_CWORD - 1]}"
  commands="self-help help init print self-upgrade"

  for command_dir in ./commands; do
    if [[ -d "$command_dir" ]]; then
      for cli_command in "$command_dir"/*; do
        [[ -f "$cli_command" ]] || continue
        [[ "${cli_command##*/}" != "cdd" ]] || continue
        case " $commands " in
          *" ${cli_command##*/} "*) continue ;;
        esac
        commands="$commands ${cli_command##*/}"
      done
    fi
  done

  if [[ "$COMP_CWORD" -eq 1 ]]; then
    COMPREPLY=( $(compgen -W "$commands" -- "$current") )
    return 0
  fi

  case "$previous" in
    init)
      COMPREPLY=( $(compgen -d -- "$current") )
      return 0
      ;;
    plans:finish)
      _cdd_complete_plans_finish "$current"
      return 0
      ;;
  esac
}

_cdd_complete_plans_finish()
{
  local current="$1"
  local plan_root="plans"
  local completions=()
  local entry

  if [[ "$current" == *"/"* ]]; then
    while IFS= read -r entry; do
      entry="${entry#${plan_root}/}"
      completions+=("$entry")
    done < <(compgen -f -d -- "$plan_root/$current")
  else
    for entry in problems features; do
      if [[ -d "$plan_root/$entry" ]]; then
        completions+=("$entry/")
      fi
    done

    compopt -o nospace 2>/dev/null || true
  fi

  COMPREPLY=("${completions[@]}")
}

complete -F _cdd cdd
