_cdd()
{
  local current previous commands command_dir cli_command

  COMPREPLY=()
  current="${COMP_WORDS[COMP_CWORD]}"
  previous="${COMP_WORDS[COMP_CWORD - 1]}"
  commands="self-help help init print self-upgrade projects source-code:print source-code:volume source-code:volume:analyze source-code:volume:assess"

  for command_dir in ./commands ./concepts/cdd-cli-commands; do
    if [[ -d "$command_dir" ]]; then
      for cli_command in "$command_dir"/*; do
        [[ -f "$cli_command" ]] || continue
        [[ "${cli_command##*/}" != "cdd" ]] || continue
        [[ "${cli_command##*.}" != "sh" ]] || continue
        case " $commands " in
          *" ${cli_command##*/} "*) continue ;;
        esac
        commands="$commands ${cli_command##*/}"
      done
    fi
  done

  if [[ "$COMP_CWORD" -eq 1 ]]; then
    COMPREPLY=( $(compgen -W "$commands" -- "$current") )
    return 0
  fi

  case "$previous" in
    ide|ide:which)
      COMPREPLY=( $(compgen -f -- "$current") )
      compopt -o filenames 2>/dev/null || true
      return 0
      ;;
    init)
      COMPREPLY=( $(compgen -d -- "$current") )
      return 0
      ;;
    source-code:print|source-code:volume|source-code:volume:analyze)
      COMPREPLY=( $(compgen -f -d -- "$current") )
      compopt -o filenames 2>/dev/null || true
      return 0
      ;;
    plans:finish)
      _cdd_complete_plans_finish "$current"
      return 0
      ;;
    projects)
      _cdd_complete_projects "$current"
      return 0
      ;;
  esac

  case "${COMP_WORDS[1]:-}" in
    projects)
      _cdd_complete_projects "$current"
      return 0
      ;;
  esac
}

_cdd_complete_plans_finish()
{
  local current="$1"
  local plan_root="plans"
  local completions=()
  local entry

  if [[ "$current" == *"/"* ]]; then
    while IFS= read -r entry; do
      entry="${entry#${plan_root}/}"
      completions+=("$entry")
    done < <(compgen -f -d -- "$plan_root/$current")
  else
    for entry in problems features; do
      if [[ -d "$plan_root/$entry" ]]; then
        completions+=("$entry/")
      fi
    done

    compopt -o nospace 2>/dev/null || true
  fi

  COMPREPLY=("${completions[@]}")
}

_cdd_complete_projects()
{
  local current="$1"
  local projects_root="${CDD_PROJECTS_DIRECTORY:-$HOME/Projects}"
  local completions=()
  local entry

  case "${COMP_WORDS[2]:-}" in
    cd|pwd)
      if [[ -d "$projects_root" ]]; then
        while IFS= read -r entry; do
          entry="${entry#${projects_root}/}"
          completions+=("$entry")
        done < <(compgen -d -- "$projects_root/$current")
      fi
      ;;
    ls)
      return 0
      ;;
    *)
      completions+=(ls cd pwd)
      compopt -o nospace 2>/dev/null || true
      ;;
  esac

  COMPREPLY=("${completions[@]}")
}

complete -F _cdd cdd
