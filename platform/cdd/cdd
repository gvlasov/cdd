#!/usr/bin/env bash
# Run Concept-Driven Design project commands
set -euo pipefail

source_path="${BASH_SOURCE[0]}"
while [ -L "$source_path" ]; do
  source_dir="$(cd -P "$(dirname "$source_path")" >/dev/null 2>&1 && pwd)"
  source_path="$(readlink "$source_path")"
  case "$source_path" in
    /*) ;;
    *) source_path="$source_dir/$source_path" ;;
  esac
done

source_dir="$(cd -P "$(dirname "$source_path")" >/dev/null 2>&1 && pwd)"
cdd_home="$(cd "$source_dir/../.." >/dev/null 2>&1 && pwd)"

command="${1:-self-help}"
command_dir="$cdd_home/concepts/cdd-cli-commands"
case "$command" in
  self-help|--help|-h)
    exec "$command_dir/self-help"
    ;;
  help)
    exec "$command_dir/help"
    ;;
  init)
    shift
    exec "$command_dir/init" "$@"
    ;;
  self-upgrade)
    shift
    exec "$command_dir/self-upgrade" "$@"
    ;;
  print)
    shift
    exec "$command_dir/print" "$@"
    ;;
  projects)
    shift
    exec "$command_dir/projects" "$@"
    ;;
  *)
    shift
    if [ -x "$command_dir/$command" ] && [ "$command" != "cdd" ]; then
      exec "$command_dir/$command" "$@"
    fi
    if [ -x "./commands/$command" ] && [ "$command" != "cdd" ]; then
      exec "./commands/$command" "$@"
    fi
    if [ -x "$cdd_home/commands/$command" ] && [ "$command" != "cdd" ]; then
      exec "$cdd_home/commands/$command" "$@"
    fi
    printf 'cdd: unknown command: %s\n' "$command" >&2
    printf 'Run `cdd help` to see available commands.\n' >&2
    exit 1
    ;;
esac
