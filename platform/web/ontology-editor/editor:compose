#!/usr/bin/env bash
# Forward Docker Compose commands to the ontology editor's local environment.
set -euo pipefail

source_path="${BASH_SOURCE[0]}"
while [ -L "$source_path" ]; do
  source_dir="$(cd -P "$(dirname "$source_path")" >/dev/null 2>&1 && pwd)"
  source_path="$(readlink "$source_path")"
  case "$source_path" in
    /*) ;;
    *) source_path="$source_dir/$source_path" ;;
  esac
done
project_dir="$(cd -P "$(dirname "$source_path")" >/dev/null 2>&1 && pwd)"

exec docker compose \
  --project-directory "$project_dir" \
  -f "$project_dir/envs/local-development/compose.yaml" \
  "$@"
