#!/usr/bin/env bash
# Build the embeddable ontology-editor component bundle and publish it to
# ./concepts/ontology-editor/dist so other projects in the repo can consume it.
set -euo pipefail

source_path="${BASH_SOURCE[0]}"
while [ -L "$source_path" ]; do
  source_dir="$(cd -P "$(dirname "$source_path")" >/dev/null 2>&1 && pwd)"
  source_path="$(readlink "$source_path")"
  case "$source_path" in
    /*) ;;
    *) source_path="$source_dir/$source_path" ;;
  esac
done
project_dir="$(cd -P "$(dirname "$source_path")" >/dev/null 2>&1 && pwd)"
cd "$project_dir"

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || repo_root="$project_dir"
out_dir="$repo_root/concepts/ontology-editor"

if [ ! -d node_modules ]; then
  printf 'editor:build: installing dependencies...\n' >&2
  npm install
fi

npm run build:lib

mkdir -p "$out_dir"
rm -rf "$out_dir/dist"
cp -R dist "$out_dir/dist"

printf 'editor:build: wrote %s\n' "$out_dir/dist"
