#!/usr/bin/env bash
# Bring up the local environment for the ontology editor: install dependencies
# if needed and start the Vite dev server (HMR). No backend.
#
# With --open, also open the app in the browser once Vite is serving.
set -euo pipefail

source_path="${BASH_SOURCE[0]}"
while [ -L "$source_path" ]; do
  source_dir="$(cd -P "$(dirname "$source_path")" >/dev/null 2>&1 && pwd)"
  source_path="$(readlink "$source_path")"
  case "$source_path" in
    /*) ;;
    *) source_path="$source_dir/$source_path" ;;
  esac
done
project_dir="$(cd -P "$(dirname "$source_path")" >/dev/null 2>&1 && pwd)"
cd "$project_dir"

open_browser=0
for arg in "$@"; do
  case "$arg" in
    --open) open_browser=1 ;;
  esac
done

if [ ! -d node_modules ]; then
  printf 'editor:up: installing dependencies...\n' >&2
  npm install
fi

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || repo_root="$project_dir"
open_in_browser="$repo_root/commands/open-in-browser"

# Preferred port for this project; Vite falls through if it is taken, so the
# waiter below probes a small range starting here.
port="${EDITOR_PORT:-5274}"

if [ "$open_browser" -eq 1 ]; then
  (
    for _ in $(seq 1 100); do
      for p in $(seq "$port" $((port + 20))); do
        if curl -sf -o /dev/null "http://127.0.0.1:${p}/"; then
          [ -x "$open_in_browser" ] && "$open_in_browser" "http://127.0.0.1:${p}/" || true
          exit 0
        fi
      done
      sleep 0.3
    done
  ) &
fi

# Vite runs in the foreground and owns its own SIGINT/SIGTERM handling, so
# Ctrl-C stops it cleanly with no orphaned process.
exec npm run dev -- --host 127.0.0.1 --port "$port"
