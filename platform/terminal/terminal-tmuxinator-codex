#!/usr/bin/env bash
# Opens the Codex project terminal through the shared tmuxinator launcher.
set -euo pipefail

source_path="${BASH_SOURCE[0]}"
while [ -L "$source_path" ]; do
  source_dir="$(cd -P "$(dirname "$source_path")" >/dev/null 2>&1 && pwd)"
  source_path="$(readlink "$source_path")"
  case "$source_path" in
    /*) ;;
    *) source_path="$source_dir/$source_path" ;;
  esac
done

source_dir="$(cd -P "$(dirname "$source_path")" >/dev/null 2>&1 && pwd)"
exec "$source_dir/terminal-tmuxinator" codex
