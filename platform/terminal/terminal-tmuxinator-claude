#!/usr/bin/env bash
# Opens the last Claude Code session for this CDD project in an xterm-backed tmuxinator session
set -euo pipefail

find_project_root() {
  local dir
  dir="$(pwd)"

  while [ "$dir" != "/" ]; do
    if [ -d "$dir/commands" ]; then
      printf '%s\n' "$dir"
      return 0
    fi
    dir="$(dirname "$dir")"
  done

  return 1
}

require_command() {
  local command_name="$1"

  if ! command -v "$command_name" >/dev/null 2>&1; then
    printf 'terminal-tmuxinator-claude: required command not found: %s\n' "$command_name" >&2
    exit 1
  fi
}

focus_existing_i3_window() {
  local window_class="$1"
  local tree

  command -v i3-msg >/dev/null 2>&1 || return 1
  tree="$(i3-msg -t get_tree 2>/dev/null)" || return 1

  if ! printf '%s' "$tree" | grep -Eq "\"class\"[[:space:]]*:[[:space:]]*\"$window_class\""; then
    return 1
  fi

  i3-msg "[class=\"$window_class\"] focus" >/dev/null 2>&1
}

yaml_single_quote() {
  sed "s/'/''/g; s/^/'/; s/$/'/"
}

project_root="$(find_project_root || true)"
if [ -z "$project_root" ]; then
  printf 'terminal-tmuxinator-claude: run this from inside a CDD project with ./commands\n' >&2
  exit 1
fi

window_class="cdd-tmuxinator-claude"
if focus_existing_i3_window "$window_class"; then
  exit 0
fi

require_command xterm
require_command tmux
require_command tmuxinator

state_dir="$project_root/platform/tmuxinator/local"
mkdir -p "$state_dir"

project_id="$(printf '%s' "$project_root" | sha256sum | awk '{ print substr($1, 1, 12) }')"
project_name="$(basename "$project_root" | tr -d '\n' | tr -c '[:alnum:]_-' '-')"
session_name="cdd-claude-${project_name}-${project_id}"
config_path="$state_dir/terminal-tmuxinator-claude.yml"
quoted_project_root="$(printf '%s' "$project_root" | yaml_single_quote)"

selected_llm="claude"
if [ -f "$config_path" ] && grep -Eq '^[[:space:]]*-[[:space:]]+codex([[:space:]]|$)' "$config_path"; then
  selected_llm="codex"
fi

case "$selected_llm" in
  codex)
    claude_comment="#"
    codex_comment=""
    ;;
  claude)
    claude_comment=""
    codex_comment="#"
    ;;
esac

require_command "$selected_llm"

{
  printf 'name: %s\n' "$session_name"
  printf 'root: %s\n' "$quoted_project_root"
  printf 'windows:\n'
  printf '  - claude:\n'
  printf '      panes:\n'
  printf '        %s- claude --resume\n' "$claude_comment"
  printf '        %s- codex --approve-for-me resume\n' "$codex_comment"
} > "$config_path"

exec xterm \
  -class "$window_class" \
  -T "Claude - $project_name" \
  -e bash -lc '
    tmuxinator start -p "$1"
    status="$?"

    if [ "$status" -ne 0 ]; then
      printf "\nterminal-tmuxinator-claude failed with exit code %s.\n" "$status" >&2
      printf "Press Enter to close this terminal." >&2
      read -r _
    fi

    exit "$status"
  ' terminal-tmuxinator-claude "$config_path"
