#!/usr/bin/env bash
# Opens a project-scoped Claude Code or Codex terminal in tmuxinator.
set -euo pipefail

if [ "$#" -ne 1 ]; then
  printf 'usage: terminal-tmuxinator <claude|codex>\n' >&2
  exit 2
fi

launcher_llm="$1"
case "$launcher_llm" in
  claude|codex) ;;
  *)
    printf 'terminal-tmuxinator: unsupported LLM: %s (expected claude or codex)\n' "$launcher_llm" >&2
    exit 2
    ;;
esac

launcher_name="terminal-tmuxinator-$launcher_llm"

find_project_root() {
  local dir
  dir="$(pwd)"

  while [ "$dir" != "/" ]; do
    if [ -d "$dir/commands" ]; then
      printf '%s\n' "$dir"
      return 0
    fi
    dir="$(dirname "$dir")"
  done

  return 1
}

require_command() {
  local command_name="$1"

  if ! command -v "$command_name" >/dev/null 2>&1; then
    printf '%s: required command not found: %s\n' "$launcher_name" "$command_name" >&2
    exit 1
  fi
}

focus_existing_i3_window() {
  local window_class="$1"
  local tree

  command -v i3-msg >/dev/null 2>&1 || return 1
  tree="$(i3-msg -t get_tree 2>/dev/null)" || return 1

  if ! printf '%s' "$tree" | grep -Eq "\"class\"[[:space:]]*:[[:space:]]*\"$window_class\""; then
    return 1
  fi

  i3-msg "[class=\"$window_class\"] focus" >/dev/null 2>&1
}

yaml_single_quote() {
  sed "s/'/''/g; s/^/'/; s/$/'/"
}

project_root="$(find_project_root || true)"
if [ -z "$project_root" ]; then
  printf '%s: run this from inside a CDD project with ./commands\n' "$launcher_name" >&2
  exit 1
fi

window_class="cdd-tmuxinator-$launcher_llm"
if focus_existing_i3_window "$window_class"; then
  exit 0
fi

require_command xterm
require_command tmux
require_command tmuxinator

state_dir="$project_root/platform/tmuxinator/local"
mkdir -p "$state_dir"

project_id="$(printf '%s' "$project_root" | sha256sum | awk '{ print substr($1, 1, 12) }')"
project_name="$(basename "$project_root" | tr -d '\n' | tr -c '[:alnum:]_-' '-')"
session_name="cdd-${launcher_llm}-${project_name}-${project_id}"
config_path="$state_dir/terminal-tmuxinator-${launcher_llm}.yml"
quoted_project_root="$(printf '%s' "$project_root" | yaml_single_quote)"

case "$launcher_llm" in
  claude)
    selected_llm="claude"
    if [ -f "$config_path" ] && grep -Eq '^[[:space:]]*-[[:space:]]+codex([[:space:]]|$)' "$config_path"; then
      selected_llm="codex"
    fi

    case "$selected_llm" in
      codex)
        claude_comment="#"
        codex_comment=""
        ;;
      claude)
        claude_comment=""
        codex_comment="#"
        ;;
    esac

    require_command "$selected_llm"

    pane_lines() {
      printf '        %s- claude --resume\n' "$claude_comment"
      printf '        %s- codex --dangerously-bypass-approvals-and-sandbox resume\n' "$codex_comment"
    }
    ;;
  codex)
    require_command codex

    pane_lines() {
      printf '        - codex --dangerously-bypass-approvals-and-sandbox\n'
    }
    ;;
esac

{
  printf 'name: %s\n' "$session_name"
  printf 'root: %s\n' "$quoted_project_root"
  printf 'windows:\n'
  printf '  - %s:\n' "$launcher_llm"
  printf '      panes:\n'
  pane_lines
} > "$config_path"

exec xterm \
  -xrm '*VT100*translations: #override Ctrl <Key>V: insert-selection(CLIPBOARD)' \
  -class "$window_class" \
  -T "${launcher_llm^} - $project_name" \
  -e bash -lc '
    tmuxinator start -p "$1"
    status="$?"

    if [ "$status" -ne 0 ]; then
      printf "\n%s failed with exit code %s.\n" "$2" "$status" >&2
      printf "Press Enter to close this terminal." >&2
      read -r _
    fi

    exit "$status"
  ' terminal-tmuxinator "$config_path" "$launcher_name"
