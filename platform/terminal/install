#!/usr/bin/env bash
# Installs the CDD Codex project terminal launcher in ~/.local/bin
set -euo pipefail

source_path="${BASH_SOURCE[0]}"
while [ -L "$source_path" ]; do
  source_dir="$(cd -P "$(dirname "$source_path")" >/dev/null 2>&1 && pwd)"
  source_path="$(readlink "$source_path")"
  case "$source_path" in
    /*) ;;
    *) source_path="$source_dir/$source_path" ;;
  esac
done

source_dir="$(cd -P "$(dirname "$source_path")" >/dev/null 2>&1 && pwd)"
install_dir="$HOME/.local/bin"

mkdir -p "$install_dir"
command -p install -m 0755 "$source_dir/terminal-tmuxinator-codex" "$install_dir/terminal-tmuxinator-codex"

printf 'Installed terminal-tmuxinator-codex to %s/terminal-tmuxinator-codex\n' "$install_dir"
